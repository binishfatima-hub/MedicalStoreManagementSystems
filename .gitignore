# ============================================================
#  Files that should NOT go to GitHub.
#
#  These are all things that get created again automatically on
#  whichever computer the project is opened on, so putting them
#  in the repository only makes it big and messy.
# ============================================================


# ---------- compiled output ----------
target/
out/
build/
bin/
*.class
*.jar
*.war


# ---------- IntelliJ IDEA ----------
# .idea holds settings that belong to ONE computer (window sizes,
# local paths, which files were open). They cause merge conflicts
# and are useless to anyone else.
.idea/
*.iml
*.iws
*.ipr


# ---------- Eclipse / VS Code / NetBeans ----------
.settings/
.classpath
.project
.vscode/
nbproject/


# ---------- logs and temporary files ----------
*.log
logs/
*.tmp
*.bak
*.swp


# ---------- Windows / macOS junk ----------
Thumbs.db
Desktop.ini
.DS_Store


# ---------- Maven wrapper downloads ----------
.mvn/wrapper/maven-wrapper.jar


# ---------- Claude Code helper files ----------
.claude/


# ---------- local database backups ----------
# Safety copies taken on this computer. Useful locally, but they
# are not part of the project, so they stay out of the repository.
database/backup/


# ============================================================
#  NOTE - things that ARE kept on purpose:
#
#    database/schema.sql      needed to create the database
#    database/seed-data.sql   optional sample medicines
#    mvnw, mvnw.cmd, pom.xml  needed to build the backend
#    MediCareWebsite/         the whole website
#
#  The DATA inside MySQL is NOT in this repository - a database
#  lives on your computer, not in Git. Anyone who clones this
#  project runs database/schema.sql to build their own copy.
# ============================================================
